# Modèle du fichier .env.production (à créer SUR LE SERVEUR, jamais dans git).
# Chaque valeur « À GÉNÉRER » doit être unique et secrète.

# --- Domaine public (HTTPS automatique) ---
DOMAINE=app.exemple.sn
APP_URL=https://app.exemple.sn

# --- Base de données (mot de passe en hexadécimal : openssl rand -hex 24) ---
POSTGRES_USER=nuuf
POSTGRES_PASSWORD=À GÉNÉRER
POSTGRES_DB=nuuf

# --- Sécurité de l'application ---
# openssl rand -base64 48   (32 caractères minimum, sinon l'application refuse de créer des sessions)
SESSION_SECRET=À GÉNÉRER
# Numéros des administrateurs Nuuf, séparés par des virgules (accès au back-office /admin)
ADMIN_PHONES=+221XXXXXXXXX

# --- Paiements ---
# Laisser vide en production : la simulation est alors désactivée. Passer à "reel" une fois Wave / Orange Money branchés.
PAIEMENT_MODE=
# openssl rand -hex 32   (secret partagé avec les opérateurs pour signer les webhooks)
PAIEMENT_WEBHOOK_SECRET=À GÉNÉRER

# --- Messages WhatsApp (codes de vérification, relances automatiques) ---
# "whatsapp_cloud" une fois le compte WhatsApp Business (Meta) ouvert ; laisser vide = aucun message envoyé.
MESSAGERIE_MODE=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Noms des modèles approuvés par Meta (facultatif ; sinon texte libre, limité à la fenêtre de 24 h) :
# WHATSAPP_TEMPLATE_OTP=  WHATSAPP_TEMPLATE_RELANCE=
# openssl rand -hex 32   (secret du planificateur des relances automatiques)
CRON_SECRET=À GÉNÉRER

# --- Mentions légales (facultatif) ---
NEXT_PUBLIC_RAISON_SOCIALE=

# --- Contact public affiché dans le pied de page (facultatif) ---
NEXT_PUBLIC_CONTACT_WHATSAPP=221XXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=contact@exemple.sn

# --- Sauvegardes hors serveur (facultatif mais fortement recommandé, voir DEPLOIEMENT.md) ---
# Remote rclone, ex. "b2:nuuf-sauvegardes" ; phrase de passe de chiffrement des sauvegardes.
BACKUP_RCLONE_REMOTE=
BACKUP_PASSPHRASE=À GÉNÉRER
