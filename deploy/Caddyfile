# HTTPS automatique (Let's Encrypt) pour le domaine défini dans .env.production (DOMAINE).
{$DOMAINE} {
	encode zstd gzip

	# Les photos de biens et documents de locataires passent par l'application (25 Mo au plus, comme dans next.config.ts) :
	# on borne les corps de requête juste au-dessus. Le webhook des opérateurs n'a besoin que de quelques Ko.
	request_body {
		max_size 26MB
	}
	@webhook path /api/webhooks/*
	request_body @webhook {
		max_size 64KB
	}

	reverse_proxy app:3000 {
		# Caddy transmet X-Forwarded-For / -Proto / -Host automatiquement.
		health_uri /api/sante
		health_interval 30s
	}

	# Les fichiers compilés ont un nom qui change à chaque version : cache long sans risque.
	@statiques path /_next/static/*
	header @statiques Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format json
	}
}
