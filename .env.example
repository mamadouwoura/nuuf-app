# Nuuf : variables d'environnement. Copiez ce fichier en .env (jamais dans le dépôt) et renseignez les valeurs.
# L'état de chacune est visible dans la console d'administration, page « Intégrations ».

# ---------- Obligatoires ----------
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/nuuf"
# Clé de signature des sessions : 32 caractères minimum, aléatoire (ex. : openssl rand -hex 32).
SESSION_SECRET=""
# Adresse publique du site, en https : sert à tous les liens envoyés (paiement, quittance, invitation).
APP_URL="https://nuuf.exemple.sn"
# Numéros administrateurs (format international, séparés par des virgules).
ADMIN_PHONES="+221770000000"
# Secret du planificateur (relances, échéances) : 24 caractères minimum. Appel : Authorization: Bearer <secret> sur /api/cron/relances.
CRON_SECRET=""

# ---------- Paiement Wave / Orange Money ----------
# « simulation » : aucun argent réel (démonstration). Le mode réel s'activera avec les accès marchands.
PAIEMENT_MODE="simulation"
PAIEMENT_WEBHOOK_SECRET=""

# ---------- Messages WhatsApp (codes de connexion, relances, liens) ----------
# simulation | whatsapp_cloud | (vide = désactivé)
MESSAGERIE_MODE="simulation"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Modèles approuvés par Meta (un par type de message), facultatifs : WHATSAPP_TEMPLATE_OTP, _RELANCE, _RENOUVELLEMENT, _LIEN_PAIEMENT, _QUITTANCE

# ---------- E-mail des notifications ----------
# simulation | resend | (vide = désactivé)
EMAIL_MODE="simulation"
RESEND_API_KEY=""
EMAIL_FROM="Nuuf <notifications@exemple.sn>"

# ---------- Notifications push (générez les clés avec « npm run vapid ») ----------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@exemple.sn"

# ---------- Affichage public ----------
NEXT_PUBLIC_RAISON_SOCIALE=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# ---------- Facultatifs ----------
# Démonstration uniquement : affiche le code de connexion à l'écran. JAMAIS avec de vrais clients.
# NUUF_DEMO="1"
# Dossier des fichiers envoyés (photos, pièces) : doit être un stockage durable.
# UPLOAD_DIR="/var/lib/nuuf/uploads"
# Taille du pool de connexions à la base.
# DB_POOL_MAX="5"
# Limites anti-abus.
# OTP_MAX_PAR_HEURE="20"
# INSCRIPTIONS_MAX_PAR_HEURE="30"
