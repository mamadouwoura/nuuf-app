// Schéma Nuuf — multi-tenant : chaque donnée métier porte organisationId.
// Montants en FCFA (entiers, pas de décimales).

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PROPRIETAIRE
  GESTIONNAIRE
  LECTURE_SEULE
}

enum Forfait {
  DECOUVERTE
  BAILLEUR
  PRO
  AGENCE
}

enum StatutAbonnement {
  ESSAI
  ACTIF
  GRACE
  LECTURE_SEULE
  RESILIE
}

enum TypeBien {
  APPARTEMENT
  VILLA
  STUDIO
  COMMERCIAL
}

enum StatutEcheance {
  EN_ATTENTE
  PAYEE
  PARTIELLE
  EN_RETARD
}

enum CanalPaiement {
  WAVE
  ORANGE_MONEY
  ESPECES
  VIREMENT
}

enum StatutPaiement {
  INITIE
  CONFIRME
  ECHEC
  EXPIRE
}

enum CanalMessage {
  WHATSAPP
  SMS
}

enum TypeMessage {
  OTP
  LIEN_PAIEMENT
  QUITTANCE
  RELANCE
  RENOUVELLEMENT
}

// Un compte client Nuuf (bailleur particulier ou cabinet). Porte l'abonnement.
model Organisation {
  id     String   @id @default(cuid())
  nom    String
  ninea  String?
  // Coordonnées imprimées sur les documents (contrats, mandats, bilans, quittances).
  adresse      String?
  telephonePro String?
  email        String?
  ville      String? // Dakar, Thiès, Mbour, Autre (déclaré à l'inscription)
  tailleParc String? // 1-5, 6-20, 21-50, 50+
  profil     String? // déclaré à l'inscription : PARTICULIER ou AGENCE (indicatif, aucun droit n'en découle)
  creeLe DateTime @default(now())

  membres             Membre[]
  biens               Bien[]
  locataires          Locataire[]
  abonnement          Abonnement?
  comptesEncaissement CompteEncaissement[]
  messages            Message[]
  journal             JournalAction[]
  consultations       ConsultationHistorique[]
  proprietaires       Proprietaire[]
  transactions        Transaction[]
  logo                LogoOrganisation?
}

// Logo de l'organisation : table à part pour ne pas alourdir les requêtes courantes.
model LogoOrganisation {
  organisationId String       @id
  octets         Bytes
  type           String // png ou jpg
  majLe          DateTime     @default(now()) @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

// Une personne qui se connecte (téléphone + mot de passe + OTP).
model Utilisateur {
  id           String    @id @default(cuid())
  telephone    String    @unique // format +221XXXXXXXXX
  nomComplet   String
  motDePasse   String // hash
  telVerifieLe DateTime?
  creeLe       DateTime  @default(now())
  // Incrémenté à chaque changement de mot de passe : coupe toutes les sessions ouvertes.
  sessionVersion Int      @default(0)

  membres  Membre[]
  codesOtp CodeOtp[]
  journal  JournalAction[]
  sessions SessionUtilisateur[]
}

// Une session ouverte : le cookie signé porte son identifiant ; la déconnexion la supprime ici.
model SessionUtilisateur {
  id            String   @id // aléatoire, jamais deviné
  utilisateurId String
  creeLe        DateTime @default(now())
  expireLe      DateTime

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([expireLe])
}

// Inscription non encore confirmée : le compte n'existe qu'après validation du code reçu sur le téléphone.
model InscriptionEnAttente {
  id         String   @id @default(cuid())
  telephone  String   @unique
  nomComplet String
  motDePasse String // haché
  ville      String?
  tailleParc String?
  profil     String?
  codeHash   String
  tentatives Int      @default(0)
  envois     Int      @default(1)
  creeLe     DateTime @default(now())
  expireLe   DateTime

  @@index([expireLe])
}

// Appartenance d'un utilisateur à une organisation, avec son rôle.
model Membre {
  id             String   @id @default(cuid())
  organisationId String
  utilisateurId  String
  role           Role
  creeLe         DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  utilisateur  Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([organisationId, utilisateurId])

  @@index([utilisateurId])
}

model CodeOtp {
  id            String    @id @default(cuid())
  utilisateurId String
  codeHash      String
  expireLe      DateTime
  utiliseLe     DateTime?
  tentatives    Int       @default(0)
  creeLe        DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, expireLe])
}

model Abonnement {
  id             String           @id @default(cuid())
  organisationId String           @unique
  forfait        Forfait
  statut         StatutAbonnement
  annuel         Boolean          @default(false)
  essaiFinLe     DateTime?
  periodeFinLe   DateTime?
  graceFinLe     DateTime?
  creeLe         DateTime         @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  factures     FactureAbonnement[]
}

model FactureAbonnement {
  id                 String    @id @default(cuid())
  abonnementId       String
  forfait            Forfait
  annuel             Boolean   @default(false)
  montant            Int
  nbLogements        Int
  periodeDebut       DateTime
  periodeFin         DateTime
  payeeLe            DateTime?
  referenceOperateur String?   @unique
  creeLe             DateTime  @default(now())

  abonnement Abonnement @relation(fields: [abonnementId], references: [id], onDelete: Cascade)

  @@index([abonnementId])
}

// Compte Wave / Orange Money où le bailleur reçoit ses loyers.
model CompteEncaissement {
  id             String        @id @default(cuid())
  organisationId String
  canal          CanalPaiement
  telephone      String
  libelle        String?
  actif          Boolean       @default(true)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model Bien {
  id             String    @id @default(cuid())
  organisationId String
  designation    String
  type           TypeBien
  quartier       String
  ville          String
  adresse        String?
  surfaceM2      Int?
  description    String?
  creeLe         DateTime  @default(now())
  archiveLe      DateTime?
  proprietaireId String? // propriétaire pour le compte duquel une agence gère ce bien

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  proprietaire Proprietaire? @relation(fields: [proprietaireId], references: [id], onDelete: SetNull)
  baux         Bail[]
  photos       PhotoBien[]

  @@index([organisationId])
  @@index([proprietaireId])
}

// Un propriétaire dont l'agence gère les biens (mandat de gestion).
model Proprietaire {
  id             String   @id @default(cuid())
  organisationId String
  nomComplet     String
  telephone      String?
  cni            String?
  adresse        String?
  creeLe         DateTime @default(now())

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  biens        Bien[]
  mandats      Mandat[]
  retenues     RetenueBilan[]
  reversements Reversement[]
  avances      AvanceProprietaire[]

  @@index([organisationId])
}

// Contrat de mandat de gestion entre l'agence et un propriétaire.
model Mandat {
  id                    String    @id @default(cuid())
  organisationId        String
  proprietaireId        String
  numero                String // MG-2026-001, séquentiel par organisation
  commissionPct         Float // pourcentage des loyers encaissés
  debutLe               DateTime
  dureeMois             Int       @default(12)
  reconduction          Boolean   @default(true)
  jourReversement       Int       @default(10)
  plafondTravaux        Int? // FCFA, sans accord préalable
  // Apporteur / agent : sa part est prélevée sur la commission de l'agence (le net du propriétaire ne change pas).
  agentNom              String?
  commissionAgentPct    Float     @default(0)
  preavisMois           Int       @default(1)
  actif                 Boolean   @default(true)
  signatureAgence       String?
  signatureProprietaire String?
  signeLe               DateTime?
  creeLe                DateTime  @default(now())

  proprietaire Proprietaire @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)

  @@unique([organisationId, numero])
  @@index([proprietaireId])
}

// Retenue du mois sur le net à reverser (travaux, frais…).
model RetenueBilan {
  id             String   @id @default(cuid())
  organisationId String
  proprietaireId String
  mois           DateTime // 1er jour du mois concerné
  libelle        String
  montant        Int
  creeLe         DateTime @default(now())

  proprietaire Proprietaire @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)

  @@index([proprietaireId, mois])
}

// Reversement d'un mois au propriétaire (suivi manuel : Nuuf ne déplace aucun fonds).
model Reversement {
  id             String   @id @default(cuid())
  organisationId String
  proprietaireId String
  mois           DateTime
  montant        Int
  reverseLe      DateTime
  reference      String?
  creeLe         DateTime @default(now())

  proprietaire Proprietaire @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)

  @@unique([proprietaireId, mois])
}

// Photos d'un bien : le fichier est sur disque (UPLOAD_DIR), seule sa référence est en base.
model PhotoBien {
  id             String   @id @default(cuid())
  bienId         String
  organisationId String
  fichier        String   @unique // nom aléatoire sur disque
  type           String // image/jpeg | image/png | image/webp
  taille         Int
  creeLe         DateTime @default(now())

  bien Bien @relation(fields: [bienId], references: [id], onDelete: Cascade)

  @@index([bienId])
}

model Locataire {
  id             String   @id @default(cuid())
  organisationId String
  nomComplet     String
  telephone      String
  cni            String?
  cniNorm        String? // numéro de pièce sans espaces ni tirets, en majuscules : sert à la recherche d'historique
  profession     String?
  creeLe         DateTime @default(now())

  // Fiche de renseignement (remplie par l'agent, en face du locataire)
  dateNaissance           DateTime?
  lieuNaissance           String?
  dernierDomicile         String?
  contactUrgenceNom       String?
  contactUrgenceTel       String?
  situationFamiliale      String? // CELIBATAIRE | MARIE | AUTRE
  enfantsMineurs          Int?
  enfantsMajeurs          Int?
  statutPro               String? // ENTREPRENEUR | SALARIE | LIBERAL | AUTRE
  lieuTravail             String?
  justificatifs           String[] // CNI | BULLETIN | ATTESTATION | AUTRE
  ficheRemplieLe          DateTime?
  consentementHistoriqueLe DateTime?
  signature               String? // image PNG (data URL) de la signature manuscrite à l'écran
  signeLe                 DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  baux         Bail[]
  documents    DocumentLocataire[]

  @@index([organisationId])
  @@index([cniNorm])
}

// Pièce d'identité, bulletin de salaire… remis par le locataire (fichier stocké hors base, nom aléatoire).
model DocumentLocataire {
  id             String   @id @default(cuid())
  locataireId    String
  organisationId String
  categorie      String // CNI | BULLETIN | ATTESTATION | AUTRE
  fichier        String   @unique
  type           String // image/jpeg | image/png | image/webp | application/pdf
  taille         Int
  creeLe         DateTime @default(now())

  locataire Locataire @relation(fields: [locataireId], references: [id], onDelete: Cascade)

  @@index([locataireId])
}

// Trace de chaque consultation de l'historique d'un candidat (responsabilité et limitation du volume).
model ConsultationHistorique {
  id             String   @id @default(cuid())
  organisationId String
  utilisateurId  String?
  telephone      String
  dossiers       Int
  creeLe         DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, creeLe])
}

// Un bail relie un bien et un locataire pour une période.
model Bail {
  id              String    @id @default(cuid())
  bienId          String
  locataireId     String
  loyerMensuel    Int
  chargesIncluses Boolean   @default(true)
  cautionMois     Int       @default(2)
  jourEcheance    Int       @default(5)
  debutLe         DateTime
  finLe           DateTime?
  actif           Boolean   @default(true)
  motifFin        String? // FIN_NORMALE | DEPART_LOCATAIRE | FIN_BAILLEUR | AUTRE (renseigné à l'archivage)
  // Appréciation du bailleur à la fin de la location : listes fermées, pas de texte libre
  apprLogement    String? // SOIGNE | CORRECT | DEGRADE
  apprRegles      String? // BON | A_SURVEILLER | PROBLEMATIQUE
  apprSortie      String? // BON_ETAT | USURE_NORMALE | DEGRADATIONS
  apprRelouer     String? // OUI | RESERVE | NON

  bien      Bien       @relation(fields: [bienId], references: [id], onDelete: Cascade)
  locataire Locataire  @relation(fields: [locataireId], references: [id], onDelete: Restrict)
  echeances Echeance[]

  @@index([bienId])
  @@index([locataireId])
}

// Un loyer attendu pour un mois donné.
model Echeance {
  id            String         @id @default(cuid())
  bailId        String
  mois          DateTime // 1er jour du mois concerné
  montantDu     Int
  dateLimite    DateTime
  statut        StatutEcheance @default(EN_ATTENTE)
  jetonPaiement String?        @unique // lien de paiement locataire
  jetonExpireLe DateTime? // 72 h

  bail      Bail       @relation(fields: [bailId], references: [id], onDelete: Cascade)
  paiements Paiement[]
  relances  Relance[]

  @@unique([bailId, mois])

  @@index([dateLimite, statut])
}

model Paiement {
  id                 String         @id @default(cuid())
  echeanceId         String
  montant            Int
  canal              CanalPaiement
  statut             StatutPaiement
  referenceOperateur String?        @unique
  recuLe             DateTime?
  creeLe             DateTime       @default(now())

  echeance  Echeance   @relation(fields: [echeanceId], references: [id], onDelete: Cascade)
  quittance Quittance?

  @@index([echeanceId])
  @@index([statut, creeLe])
}

model Quittance {
  id             String   @id @default(cuid())
  organisationId String
  paiementId     String   @unique
  numero         String // Q-2026-10-001, séquentiel par organisation et par mois
  jetonQr        String   @unique
  emiseLe        DateTime @default(now())

  paiement Paiement @relation(fields: [paiementId], references: [id], onDelete: Cascade)

  @@unique([organisationId, numero])

  @@index([organisationId, emiseLe])
}

model Relance {
  id          String   @id @default(cuid())
  echeanceId  String
  declencheur String // J-2, J+3, manuelle...
  envoyeeLe   DateTime @default(now())

  echeance Echeance @relation(fields: [echeanceId], references: [id], onDelete: Cascade)

  @@index([echeanceId])
}

// Tout message sortant WhatsApp / SMS.
model Message {
  id             String       @id @default(cuid())
  organisationId String?
  canal          CanalMessage
  type           TypeMessage
  destinataire   String
  statut         String       @default("ENVOYE")
  creeLe         DateTime     @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([type, creeLe])
}

// Qui a fait quoi (comptes équipe du forfait Pro).
model JournalAction {
  id             String   @id @default(cuid())
  organisationId String
  utilisateurId  String?
  action         String
  cible          String?
  creeLe         DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  utilisateur  Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([organisationId, creeLe])
}

// Réglages des relances automatiques (envoi réel branché en phase 2 via WhatsApp Cloud API).
model ParametresRelance {
  organisationId String  @id
  avantEcheance  Boolean @default(true) // J-3
  apresJ1        Boolean @default(true)
  apresJ5        Boolean @default(true)
  canal          CanalMessage @default(WHATSAPP)
}

// Échecs de connexion récents (limitation des essais de mot de passe par numéro).
model TentativeConnexion {
  id     String   @id @default(cuid())
  cle    String
  creeLe DateTime @default(now())

  @@index([cle, creeLe])
}

// Avance (acompte) consentie à un propriétaire, remboursée automatiquement sur ses bilans mensuels.
model AvanceProprietaire {
  id             String   @id @default(cuid())
  organisationId String
  proprietaireId String
  montant        Int
  accordeLe      DateTime
  motif          String?
  mensualite     Int? // plafond de remboursement par mois ; vide = tout ce que le bilan permet
  creeLe         DateTime @default(now())

  proprietaire   Proprietaire         @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)
  remboursements RemboursementAvance[]

  @@index([proprietaireId])
}

// Remboursement d'une avance : prélevé sur un bilan (mois renseigné) ou versé à part (mois vide).
model RemboursementAvance {
  id             String   @id @default(cuid())
  avanceId       String
  organisationId String
  montant        Int
  mois           DateTime?
  recuLe         DateTime @default(now())
  note           String?

  avance AvanceProprietaire @relation(fields: [avanceId], references: [id], onDelete: Cascade)

  @@unique([avanceId, mois])
}

enum SensTransaction {
  ENTREE
  SORTIE
}

// Dépense ou entrée de l'agence hors loyers (travaux, frais, honoraires…), pour le suivi de trésorerie.
model Transaction {
  id             String          @id @default(cuid())
  organisationId String
  sens           SensTransaction
  categorie      String
  libelle        String
  montant        Int
  date           DateTime
  proprietaireId String?
  creeLe         DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, date])
}
